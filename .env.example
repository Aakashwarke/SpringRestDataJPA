# Copy to .env and fill in. Never commit the real file.

# --- Required in production -------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=

DATABASE_URL=jdbc:postgresql://localhost:5432/springlaunch
DATABASE_USERNAME=springlaunch
DATABASE_PASSWORD=

# --- Billing ----------------------------------------------------------------
# "fake" runs the whole app with no Stripe account and charges nobody.
# Switch to "stripe" only once the four values below are set.
BILLING_PROVIDER=fake

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCALE=

BILLING_SUCCESS_URL=https://yourapp.com/billing/success
BILLING_CANCEL_URL=https://yourapp.com/billing/cancel

PORT=8080
